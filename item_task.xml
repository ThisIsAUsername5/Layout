<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:padding="12dp">

    <ImageView
        android:id="@+id/imgTask"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:src="@android:drawable/ic_menu_agenda"
        android:contentDescription="Ikona zadania"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"/>

    <ImageView
        android:id="@+id/imgStatus"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:src="@android:drawable/checkbox_on_background"
        android:contentDescription="Status zadania"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"/>

    <TextView
        android:id="@+id/tvTaskTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nauka Androida"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_toEndOf="@id/imgTask"
        android:layout_toStartOf="@id/imgStatus"
        android:layout_alignParentTop="true"
        android:layout_marginStart="12dp"/>

    <TextView
        android:id="@+id/tvTaskDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Powtórzyć układy XML"
        android:layout_below="@id/tvTaskTitle"
        android:layout_toEndOf="@id/imgTask"
        android:layout_toStartOf="@id/imgStatus"
        android:layout_marginStart="12dp"/>

</RelativeLayout>